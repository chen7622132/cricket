{
  "name": "cricket",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Rule-table driven auto-battle core slice (PixiJS v8 + TS, deterministic 60Hz sim)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "accept": "tsx src/cli/acceptance.ts",
    "accept:report": "tsx src/cli/acceptance.ts > logs/acceptance.txt 2>&1",
    "test": "vitest run",
    "probe": "node scripts/probe.mjs",
    "capture": "node scripts/capture.mjs",
    "sprites": "node scripts/build-spritesheet.mjs"
  },
  "dependencies": {
    "pixelfx": "github:patch-gg/pixelfx",
    "pixi-filters": "^6.1.5",
    "pixi-particles-engine": "^0.1.10",
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.16.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.14",
    "vitest": "^5.1.0"
  }
}
